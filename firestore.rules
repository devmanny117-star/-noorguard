rules_version = '2';

// Community Stories rules (no auth in v1 — the app uses a per-install
// anonymous id). Manny moderates by editing `status` in the console; the
// console (admin) bypasses these rules.
service cloud.firestore {
  match /databases/{database}/documents {

    match /stories/{storyId} {
      // Approved stories are public. Pending stories are also readable so
      // the author's own submission can show up for them right away — the
      // app only ever queries pending docs filtered to its own per-install
      // userId. (No auth in v1, so this can't be enforced server-side;
      // pending stories are unpublished-but-not-secret. Revisit if
      // anonymous Firebase Auth is added.)
      allow read: if resource.data.status == 'approved'
        || resource.data.status == 'pending';

      // Anyone can submit a story, but it must arrive as a pending,
      // non-featured document with sane field types and sizes.
      allow create: if request.resource.data.status == 'pending'
        && request.resource.data.featured == false
        && request.resource.data.story is string
        && request.resource.data.story.size() > 0
        && request.resource.data.story.size() <= 5000
        && request.resource.data.name is string
        && request.resource.data.name.size() <= 100
        && request.resource.data.country is string
        && request.resource.data.category in ['revert', 'born_muslim', 'returning'];

      // Client updates may only touch the aggregate reaction/comment
      // counters (the reaction transaction and comment counter).
      allow update: if request.resource.data.diff(resource.data)
          .affectedKeys().hasOnly(['reactions', 'commentCount']);

      // Lets a story's author delete their own submission from within the
      // app. No auth in v1 (see top-of-file note), so this can't verify the
      // caller is truly the device that set `userId` — it's the same trust
      // tier already accepted for the reaction/comment-counter updates
      // above. Revisit with anonymous Firebase Auth (request.auth.uid) for
      // real per-owner enforcement.
      allow delete: if resource.data.userId is string
        && resource.data.userId.size() > 0;

      match /userReactions/{userId} {
        allow read: if true;
        allow write: if request.resource.data.keys().hasOnly(['dua', 'heart']);
      }

      match /comments/{commentId} {
        allow read: if true;
        allow create: if request.resource.data.comment is string
          && request.resource.data.comment.size() > 0
          && request.resource.data.comment.size() <= 500
          && request.resource.data.name is string
          && request.resource.data.name.size() <= 100;
        allow update, delete: if false;
      }
    }

    // Everything else: locked down.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
