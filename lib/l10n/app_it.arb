  "pillar1Name": "Shahada",
  "@pillar1Name": { "description": "pillar1Name" },
  "pillar1Desc": "Dichiarazione di Fede",
  "@pillar1Desc": { "description": "pillar1Desc" },
  "pillar1Detail": "La Shahada è la testimonianza che non vi è dio all'infuori di Allah e che Muhammad ﷺ è il Suo messaggero. Pronunciarla con sincera fede è la porta d'ingresso all'Islam e il fondamento della fede musulmana.",
  "@pillar1Detail": { "description": "pillar1Detail" },
  "pillar2Name": "Salah",
  "@pillar2Name": { "description": "pillar2Name" },
  "pillar2Desc": "Le Cinque Preghiere Quotidiane",
  "@pillar2Desc": { "description": "pillar2Desc" },
  "pillar2Detail": "Il Salah è la preghiera rituale eseguita cinque volte al giorno — Fajr, Dhuhr, Asr, Maghrib e Isha. È un collegamento diretto tra il fedele e Allah, un costante promemoria della Sua presenza.",
  "@pillar2Detail": { "description": "pillar2Detail" },
  "pillar3Name": "Zakat",
  "@pillar3Name": { "description": "pillar3Name" },
  "pillar3Desc": "Elemosina Obbligatoria",
  "@pillar3Desc": { "description": "pillar3Desc" },
  "pillar3Detail": "La Zakat è la donazione annuale del 2,5% dei risparmi a chi ne ha bisogno. Purifica la ricchezza, riduce la disuguaglianza e ricorda ai credenti che ogni sostentamento viene da Allah.",
  "@pillar3Detail": { "description": "pillar3Detail" },
  "pillar4Name": "Sawm",
  "@pillar4Name": { "description": "pillar4Name" },
  "pillar4Desc": "Digiuno nel Ramadan",
  "@pillar4Desc": { "description": "pillar4Desc" },
  "pillar4Detail": "Il Sawm è il digiuno osservato durante il sacro mese di Ramadan, astenendosi dal mangiare, bere e peccare dall'alba al tramonto. Sviluppa la taqwa e la gratitudine per le benedizioni di Allah.",
  "@pillar4Detail": { "description": "pillar4Detail" },
  "pillar5Name": "Hajj",
  "@pillar5Name": { "description": "pillar5Name" },
  "pillar5Desc": "Pellegrinaggio alla Mecca",
  "@pillar5Desc": { "description": "pillar5Desc" },
  "pillar5Detail": "L'Hajj è il pellegrinaggio alla città sacra della Mecca, obbligatorio una volta nella vita per ogni musulmano fisicamente ed economicamente in grado di compierlo. È un potente simbolo di unità e sottomissione ad Allah.",
  "@pillar5Detail": { "description": "pillar5Detail" }
}