  "howToPrayStep1Name": "Wudu First",
  "@howToPrayStep1Name": {
    "description": "Name of how-to-pray step 1"
  },
  "howToPrayStep1Instruction": "Perform wudu (ablution) so that you are in a state of purity before you begin to pray.",
  "@howToPrayStep1Instruction": {
    "description": "Instruction text for how-to-pray step 1"
  },
  "howToPrayStep1Tip": "If you're unsure how, open the Wudu Guide from the New Muslim Hub first.",
  "@howToPrayStep1Tip": {
    "description": "Beginner tip for how-to-pray step 1"
  },
  "howToPrayStep2Name": "Stand Facing the Qibla",
  "@howToPrayStep2Name": {
    "description": "Name of how-to-pray step 2"
  },
  "howToPrayStep2Instruction": "Stand on your prayer mat facing the Qibla — the direction of the Kaaba in Mecca. Use the Qibla compass in the app to find the exact direction.",
  "@howToPrayStep2Instruction": {
    "description": "Instruction text for how-to-pray step 2"
  },
  "howToPrayStep2Tip": "It's okay if you're slightly off — Allah knows your intention. Try your best.",
  "@howToPrayStep2Tip": {
    "description": "Beginner tip for how-to-pray step 2"
  },
  "howToPrayStep3Name": "Niyyah (Intention)",
  "@howToPrayStep3Name": {
    "description": "Name of how-to-pray step 3"
  },
  "howToPrayStep3Instruction": "Make the intention in your heart for the prayer you are about to perform. You do not need to say it out loud.",
  "@howToPrayStep3Instruction": {
    "description": "Instruction text for how-to-pray step 3"
  },
  "howToPrayStep3Tip": "Your intention is between you and Allah. A simple thought like 'I am praying Fajr for Allah' is enough.",
  "@howToPrayStep3Tip": {
    "description": "Beginner tip for how-to-pray step 3"
  },
  "howToPrayStep4Name": "Takbir (Opening)",
  "@howToPrayStep4Name": {
    "description": "Name of how-to-pray step 4"
  },
  "howToPrayStep4Instruction": "Raise both hands to your earlobes and say 'Allahu Akbar' (Allah is the Greatest). This officially begins your prayer.",
  "@howToPrayStep4Instruction": {
    "description": "Instruction text for how-to-pray step 4"
  },
  "howToPrayStep4Tip": "Keep your eyes focused downward toward your place of prostration throughout the prayer.",
  "@howToPrayStep4Tip": {
    "description": "Beginner tip for how-to-pray step 4"
  },
  "howToPrayStep5Name": "Qiyam (Standing)",
  "@howToPrayStep5Name": {
    "description": "Name of how-to-pray step 5"
  },
  "howToPrayStep5Instruction": "Place your right hand over your left hand on your chest. Recite Surah Al-Faatiha followed by any other short surah or verses you know.",
  "@howToPrayStep5Instruction": {
    "description": "Instruction text for how-to-pray step 5"
  },
  "howToPrayStep5Tip": "If you don't know any other surah yet, reciting Al-Faatiha alone is acceptable while you are learning.",
  "@howToPrayStep5Tip": {
    "description": "Beginner tip for how-to-pray step 5"
  },
  "howToPrayStep6Name": "Ruku (Bowing)",
  "@howToPrayStep6Name": {
    "description": "Name of how-to-pray step 6"
  },
  "howToPrayStep6Instruction": "Bow down by bending at the waist with your back parallel to the ground. Place your hands on your knees and say 'Subhana Rabbiyal Adheem' three times.",
  "@howToPrayStep6Instruction": {
    "description": "Instruction text for how-to-pray step 6"
  },
  "howToPrayStep6Tip": "Keep your back straight and horizontal — not arched or rounded.",
  "@howToPrayStep6Tip": {
    "description": "Beginner tip for how-to-pray step 6"
  },
  "howToPrayStep7Name": "Itidal (Rising from Bowing)",
  "@howToPrayStep7Name": {
    "description": "Name of how-to-pray step 7"
  },
  "howToPrayStep7Instruction": "Rise from bowing and stand upright. Say 'Sami Allahu liman hamidah' (Allah hears those who praise Him) as you rise, then say 'Rabbana lakal hamd'.",
  "@howToPrayStep7Instruction": {
    "description": "Instruction text for how-to-pray step 7"
  },
  "howToPrayStep7Tip": "Stand fully upright and be still for a moment before moving to the next position.",
  "@howToPrayStep7Tip": {
    "description": "Beginner tip for how-to-pray step 7"
  },
  "howToPrayStep8Name": "Sujood (Prostration)",
  "@howToPrayStep8Name": {
    "description": "Name of how-to-pray step 8"
  },
  "howToPrayStep8Instruction": "Go down to the ground, placing your forehead, nose, both palms, knees, and toes on the floor. Say 'Subhana Rabbiyal A'la' three times.",
  "@howToPrayStep8Instruction": {
    "description": "Instruction text for how-to-pray step 8"
  },
  "howToPrayStep8Tip": "Seven body parts must touch the ground: forehead (with nose), two hands, two knees, and two feet.",
  "@howToPrayStep8Tip": {
    "description": "Beginner tip for how-to-pray step 8"
  },
  "howToPrayStep9Name": "Jalsa (Sitting Between Prostrations)",
  "@howToPrayStep9Name": {
    "description": "Name of how-to-pray step 9"
  },
  "howToPrayStep9Instruction": "Sit up from prostration with your left foot flat and your right foot upright. Say 'Allahu Akbar' as you sit. Pause briefly, then go back down for the second prostration.",
  "@howToPrayStep9Instruction": {
    "description": "Instruction text for how-to-pray step 9"
  },
  "howToPrayStep9Tip": "This brief sitting between the two prostrations is called Jalsa. It is a required part of the prayer.",
  "@howToPrayStep9Tip": {
    "description": "Beginner tip for how-to-pray step 9"
  },
  "howToPrayStep10Name": "Complete the Rakats",
  "@howToPrayStep10Name": {
    "description": "Name of how-to-pray step 10"
  },
  "howToPrayStep10Instruction": "After completing the first rakat, stand up and repeat the same steps for the second rakat. The number of rakats depends on which prayer you are performing.",
  "@howToPrayStep10Instruction": {
    "description": "Instruction text for how-to-pray step 10"
  },
  "howToPrayStep10Tip": "Fajr has 2 rakats, Dhuhr 4, Asr 4, Maghrib 3, and Isha 4. Take it one rakat at a time.",
  "@howToPrayStep10Tip": {
    "description": "Beginner tip for how-to-pray step 10"
  },
  "howToPrayStep11Name": "Tashahhud (Final Sitting)",
  "@howToPrayStep11Name": {
    "description": "Name of how-to-pray step 11"
  },
  "howToPrayStep11Instruction": "In the final sitting position, recite the Tashahhud. This is a declaration of faith that you recite while seated after your last rakat.",
  "@howToPrayStep11Instruction": {
    "description": "Instruction text for how-to-pray step 11"
  },
  "howToPrayStep11Tip": "During Tashahhud, raise your right index finger when you say 'Ash-hadu alla ilaha illallah' as a sign of the oneness of Allah.",
  "@howToPrayStep11Tip": {
    "description": "Beginner tip for how-to-pray step 11"
  },
  "howToPrayStep12Name": "Tasleem (Closing)",
  "@howToPrayStep12Name": {
    "description": "Name of how-to-pray step 12"
  },
  "howToPrayStep12Instruction": "Turn your head to the right and say 'Assalamu Alaikum wa Rahmatullah', then turn to the left and repeat. This ends your prayer.",
  "@howToPrayStep12Instruction": {
    "description": "Instruction text for how-to-pray step 12"
  },
  "howToPrayStep12Tip": "After the prayer, take a moment to make dua (supplication) and ask Allah for what you need. This is a beautiful time to connect with Allah.",
  "@howToPrayStep12Tip": {
    "description": "Beginner tip for how-to-pray step 12"
  },
