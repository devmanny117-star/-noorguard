  "howToPrayTransTakbir": "Allah is the Greatest",
  "@howToPrayTransTakbir": {
    "description": "howToPrayTransTakbir"
  },
  "howToPrayTransOpeningDua": "Glory be to You, O Allah, and with Your praise; blessed is Your name, exalted is Your majesty, there is no god but You.",
  "@howToPrayTransOpeningDua": {
    "description": "howToPrayTransOpeningDua"
  },
  "howToPrayTransFatiha": "In the name of Allah, the Most Gracious, the Most Merciful. All praise is for Allah, Lord of all the worlds. The Most Gracious, the Most Merciful. Master of the Day of Judgment. You alone we worship, and You alone we ask for help. Guide us to the straight path — the path of those You have blessed, not of those who have earned anger, nor of those who have gone astray.",
  "@howToPrayTransFatiha": {
    "description": "howToPrayTransFatiha"
  },
  "howToPrayTransRuku": "Glory be to my Lord, the Most Great",
  "@howToPrayTransRuku": {
    "description": "howToPrayTransRuku"
  },
  "howToPrayTransItidal": "Allah hears the one who praises Him. Our Lord, and to You is all praise.",
  "@howToPrayTransItidal": {
    "description": "howToPrayTransItidal"
  },
  "howToPrayTransSujood": "Glory be to my Lord, the Most High",
  "@howToPrayTransSujood": {
    "description": "howToPrayTransSujood"
  },
  "howToPrayTransJalsa": "My Lord, forgive me",
  "@howToPrayTransJalsa": {
    "description": "howToPrayTransJalsa"
  },
  "howToPrayTransTashahhud": "All greetings, prayers, and good words belong to Allah. Peace be upon you, O Prophet, and the mercy of Allah and His blessings. Peace be upon us and upon the righteous servants of Allah. I bear witness that there is no god but Allah, and I bear witness that Muhammad is His servant and messenger.",
  "@howToPrayTransTashahhud": {
    "description": "howToPrayTransTashahhud"
  },
  "howToPrayTransSalawat": "O Allah, send Your grace on Muhammad and the family of Muhammad, as You sent Your grace on Ibrahim and the family of Ibrahim — You are the Most Praiseworthy, Most Glorious. O Allah, bless Muhammad and the family of Muhammad, as You blessed Ibrahim and the family of Ibrahim — You are the Most Praiseworthy, Most Glorious.",
  "@howToPrayTransSalawat": {
    "description": "howToPrayTransSalawat"
  },
  "howToPrayTransTasleem": "Peace and the mercy of Allah be upon you",
  "@howToPrayTransTasleem": {
    "description": "howToPrayTransTasleem"
  },
  "howToPrayOpeningDuaInstruction": "Recite this quietly right after the Opening Takbir. It is said only once, at the very start of the prayer.",
  "@howToPrayOpeningDuaInstruction": {
    "description": "howToPrayOpeningDuaInstruction"
  },
  "howToPraySurahInstruction": "After Al-Fatiha, recite any surah you know. Surah Al-Ikhlas (shown above) is perfect for beginners — recited in the first two Rak'ahs only.",
  "@howToPraySurahInstruction": {
    "description": "howToPraySurahInstruction"
  },
  "howToPrayItidalInstruction": "Say 'Sami' Allahu liman hamidah' as you rise, then stand fully upright before saying 'Rabbana wa lakal hamd'.",
