  "wuduStep1Instruction": "Make the intention in your heart to perform wudu for the sake of Allah.",
  "@wuduStep1Instruction": {
    "description": "Wudu step 1 instruction"
  },
  "wuduStep1Tip": "You don't need to say it out loud — a sincere intention in the heart is enough.",
  "@wuduStep1Tip": {
    "description": "Wudu step 1 tip"
  },
  "wuduStep2Instruction": "Say Bismillah (In the name of Allah) before you begin.",
  "@wuduStep2Instruction": {
    "description": "Wudu step 2 instruction"
  },
  "wuduStep2Tip": "Saying Bismillah is sunnah and begins your wudu with the remembrance of Allah.",
  "@wuduStep2Tip": {
    "description": "Wudu step 2 tip"
  },
  "wuduStep3Instruction": "Wash both hands up to the wrists three times, making sure water reaches between the fingers.",
  "@wuduStep3Instruction": {
    "description": "Wudu step 3 instruction"
  },
  "wuduStep3Tip": "Start with the right hand, then the left. This order is recommended in Islam.",
  "@wuduStep3Tip": {
    "description": "Wudu step 3 tip"
  },
  "wuduStep4Instruction": "Take water in your mouth, swirl it around, and spit it out. Do this three times.",
  "@wuduStep4Instruction": {
    "description": "Wudu step 4 instruction"
  },
  "wuduStep4Tip": "This cleanses the mouth and is part of the purification process.",
  "@wuduStep4Tip": {
    "description": "Wudu step 4 tip"
  },
  "wuduStep5Instruction": "Sniff water into your nostrils and blow it out gently. Do this three times.",
  "@wuduStep5Instruction": {
    "description": "Wudu step 5 instruction"
  },
  "wuduStep5Tip": "Use your right hand to sniff water and your left hand to blow it out.",
  "@wuduStep5Tip": {
    "description": "Wudu step 5 tip"
  },
  "wuduStep6Instruction": "Wash your entire face three times, from the hairline to the chin and from ear to ear.",
  "@wuduStep6Instruction": {
    "description": "Wudu step 6 instruction"
  },
  "wuduStep6Tip": "Make sure no part of your face is left dry.",
  "@wuduStep6Tip": {
    "description": "Wudu step 6 tip"
  },
  "wuduStep7Instruction": "Wash your right arm from fingertips to elbow three times, then do the same with the left arm.",
  "@wuduStep7Instruction": {
    "description": "Wudu step 7 instruction"
  },
  "wuduStep7Tip": "Always start with the right side before the left in wudu.",
  "@wuduStep7Tip": {
    "description": "Wudu step 7 tip"
  },
  "wuduStep8Instruction": "Wet your hands and wipe over your entire head once, from front to back and back to front.",
  "@wuduStep8Instruction": {
    "description": "Wudu step 8 instruction"
  },
  "wuduStep8Tip": "Unlike washing, wiping the head is done only once.",
  "@wuduStep8Tip": {
    "description": "Wudu step 8 tip"
  },
  "wuduStep9Instruction": "Wash your right foot up to and including the ankle three times, then do the same with the left foot.",
  "@wuduStep9Instruction": {
    "description": "Wudu step 9 instruction"
  },
  "wuduStep9Tip": "Make sure water reaches between the toes. Use your finger to clean between them.",
  "@wuduStep9Tip": {
    "description": "Wudu step 9 tip"
  },
