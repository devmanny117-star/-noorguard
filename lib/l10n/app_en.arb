  "communityStory1Name": "Aisha (formerly Sarah)",
  "@communityStory1Name": {
    "description": "Name for community story 1"
  },
  "communityStory1Location": "Texas, USA",
  "@communityStory1Location": {
    "description": "Location for community story 1"
  },
  "communityStory1Time": "2 years",
  "@communityStory1Time": {
    "description": "Time as Muslim for community story 1"
  },
  "communityStory1Text": "I came across Islam while doing research for a college paper. I expected to find what the media told me. Instead I found peace, logic, and a God who actually made sense. I took my shahada 6 months later. The hardest part wasn't learning to pray — it was telling my family. But Alhamdulillah, two years later, my mother is asking me questions about Islam herself.",
  "@communityStory1Text": {
    "description": "Story text for community story 1"
  },
  "communityStory2Name": "Yusuf (formerly James)",
  "@communityStory2Name": {
    "description": "Name for community story 2"
  },
  "communityStory2Location": "London, UK",
  "@communityStory2Location": {
    "description": "Location for community story 2"
  },
  "communityStory2Time": "4 years",
  "@communityStory2Time": {
    "description": "Time as Muslim for community story 2"
  },
  "communityStory2Text": "I reverted after years of searching. Christianity, Buddhism, atheism — nothing filled the void. A Muslim coworker invited me to Friday prayer. I sat in the back and cried the entire time. I didn't even know why. I took my shahada the following week. The community wrapped around me like a family I never knew I needed.",
  "@communityStory2Text": {
    "description": "Story text for community story 2"
  },
  "communityStory3Name": "Maryam (formerly Maria)",
  "@communityStory3Name": {
    "description": "Name for community story 3"
  },
  "communityStory3Location": "Mexico City, Mexico",
  "@communityStory3Location": {
    "description": "Location for community story 3"
  },
  "communityStory3Time": "1 year",
  "@communityStory3Time": {
    "description": "Time as Muslim for community story 3"
  },
  "communityStory3Text": "Being Latina and Muslim feels like a superpower. I found Islam through a YouTube video at 2am. I watched for hours. The concept of tawheed — that God is one, has no partners, no images — it resonated so deeply. My Spanish-speaking sisters at the mosque made me feel at home immediately.",
  "@communityStory3Text": {
    "description": "Story text for community story 3"
  },
  "communityStory4Name": "Ibrahim (formerly David)",
  "@communityStory4Name": {
    "description": "Name for community story 4"
  },
  "communityStory4Location": "Toronto, Canada",
  "@communityStory4Location": {
    "description": "Location for community story 4"
  },
  "communityStory4Time": "6 years",
  "@communityStory4Time": {
    "description": "Time as Muslim for community story 4"
  },
  "communityStory4Text": "I was a pastor's son. I had questions about the Trinity that no one could answer. When I read the Quran for the first time, I felt like I was reading something I already believed. I said my shahada quietly, alone, and then again at the mosque. Best decision of my life.",
  "@communityStory4Text": {
    "description": "Story text for community story 4"
  },
  "communityStory5Name": "Fatima (formerly Jennifer)",
  "@communityStory5Name": {
    "description": "Name for community story 5"
  },
  "communityStory5Location": "Sydney, Australia",
  "@communityStory5Location": {
    "description": "Location for community story 5"
  },
  "communityStory5Time": "3 years",
  "@communityStory5Time": {
    "description": "Time as Muslim for community story 5"
  },
  "communityStory5Text": "My journey started with a hijab. I put one on as a dare and felt... protected. I started reading about Islam and couldn't stop. Within three months I had taken my shahada. People ask me what I gave up. I tell them I gave up emptiness.",
  "@communityStory5Text": {
    "description": "Story text for community story 5"
  },
  "communityStory6Name": "Omar (formerly Kevin)",
  "@communityStory6Name": {
    "description": "Name for community story 6"
  },
  "communityStory6Location": "Johannesburg, South Africa",
  "@communityStory6Location": {
    "description": "Location for community story 6"
  },
  "communityStory6Time": "5 years",
  "@communityStory6Time": {
    "description": "Time as Muslim for community story 6"
  },
  "communityStory6Text": "I grew up in a rough neighborhood. Islam gave me discipline, purpose, and brotherhood. The first time I made sujood, something in me broke open — in the best way. I wept and couldn't explain why. Now I mentor other young men finding their way to the deen.",
  "@communityStory6Text": {
    "description": "Story text for community story 6"
  },
