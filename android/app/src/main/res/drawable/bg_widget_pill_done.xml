<?xml version="1.0" encoding="utf-8"?>
<!-- Completed-prayer pill in the compact small widget: subtle cream fill
     (matches every other pill) plus a green border tint to mark it done. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="#14F5EFE6" />
    <stroke
        android:width="1dp"
        android:color="#4D4CAF50" />
    <corners android:radius="10dp" />
</shape>
