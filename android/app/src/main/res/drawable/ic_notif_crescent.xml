<?xml version="1.0" encoding="utf-8"?>
<!-- Status-bar / notification small icon: Noor Guard crescent + star.
     Must be a flat white silhouette — Android tints notification small icons
     to a single color, so any internal color or alpha detail would be lost.
     The crescent is a single path of two arcs whose horn tips meet at
     (15.5, 4.21) and (15.5, 19.79): a 300° outer arc (r=9 around 11,12) for
     the moon's back, and a shallower inner arc (r=8.5 around 18.9,12) for
     the bite. The horns are genuinely open toward the right — an earlier
     version subtracted a contained inner circle, which produces a closed
     ring that reads as a plain circle at status-bar size. The 5-point star
     sits top-right, matching the app icon. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="24dp"
    android:height="24dp"
    android:viewportWidth="24"
    android:viewportHeight="24">

    <!-- Crescent (opens right) -->
    <path
        android:pathData="M15.5,4.21 A9,9 0 1,0 15.5,19.79 A8.5,8.5 0 0,1 15.5,4.21 Z"
        android:fillColor="#FFFFFFFF" />

    <!-- Star (top-right) -->
    <path
        android:pathData="M19.2,1.6 L19.9,3.7 L22.1,3.7 L20.3,5 L21,7.1 L19.2,5.8 L17.4,7.1 L18.1,5 L16.3,3.7 L18.5,3.7 Z"
        android:fillColor="#FFFFFFFF" />
</vector>
