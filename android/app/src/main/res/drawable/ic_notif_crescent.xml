<?xml version="1.0" encoding="utf-8"?>
<!-- Status-bar / notification small icon: Noor Guard crescent + star.
     Must be a flat white silhouette — Android tints notification small icons
     to a single color, so any internal color or alpha detail would be lost.
     Crescent is drawn as outer circle minus an offset inner circle via
     evenOdd fill; the 5-point star sits top-right, matching the app icon. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="24dp"
    android:height="24dp"
    android:viewportWidth="24"
    android:viewportHeight="24">

    <!-- Crescent (opens right) -->
    <path
        android:pathData="M11,3 A9,9 0 1,0 11,21 A9,9 0 1,0 11,3 Z M14.5,4.8 A7.5,7.5 0 1,0 14.5,19.2 A7.5,7.5 0 1,0 14.5,4.8 Z"
        android:fillType="evenOdd"
        android:fillColor="#FFFFFFFF" />

    <!-- Star (top-right) -->
    <path
        android:pathData="M19.2,1.6 L19.9,3.7 L22.1,3.7 L20.3,5 L21,7.1 L19.2,5.8 L17.4,7.1 L18.1,5 L16.3,3.7 L18.5,3.7 Z"
        android:fillColor="#FFFFFFFF" />
</vector>
