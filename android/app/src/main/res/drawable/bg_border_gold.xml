<?xml version="1.0" encoding="utf-8"?>
<!-- Subtle gold frame around the whole screen's content, matching the
     app's card style (gold ~35% stroke, rounded corners, no fill so the
     hero photo and gradient underneath stay visible). -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="@android:color/transparent" />
    <stroke
        android:width="1.5dp"
        android:color="#59C9A84C" />
    <corners android:radius="28dp" />
</shape>
