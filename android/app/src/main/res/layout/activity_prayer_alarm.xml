<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/navy"
    android:orientation="vertical">

    <!-- ════════════════════════════════════════════════════════════════
         HERO — top 35% of the screen: Masjid al-Haram photo, fading to
         navy at the bottom so the crescent/text overlapping it stay
         readable, with a small "Adhan Playing" badge in the corner.
         ════════════════════════════════════════════════════════════════ -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="35">

        <ImageView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:contentDescription="@null"
            android:scaleType="centerCrop"
            android:src="@drawable/img_hero_masjid" />

        <View
            android:layout_width="match_parent"
            android:layout_height="140dp"
            android:layout_gravity="bottom"
            android:background="@drawable/gradient_hero_fade" />

        <!-- Adhan playing indicator -->
        <LinearLayout
            android:id="@+id/badgeAdhanPlaying"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="top|end"
            android:layout_marginTop="26dp"
            android:layout_marginEnd="20dp"
            android:background="@drawable/bg_badge_navy"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="12dp"
            android:paddingVertical="7dp">

            <ImageView
                android:layout_width="13dp"
                android:layout_height="13dp"
                android:contentDescription="@null"
                android:src="@drawable/ic_speaker_gold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:fontFamily="sans-serif-medium"
                android:letterSpacing="0.04"
                android:text="Adhan Playing"
                android:textColor="@color/gold"
                android:textSize="11sp" />
        </LinearLayout>

        <!-- Crescent with soft glow, sitting over the bottom of the photo -->
        <FrameLayout
            android:id="@+id/crescentContainer"
            android:layout_width="96dp"
            android:layout_height="96dp"
            android:layout_gravity="bottom|center_horizontal"
            android:layout_marginBottom="14dp">

            <View
                android:layout_width="96dp"
                android:layout_height="96dp"
                android:layout_gravity="center"
                android:background="@drawable/glow_gold_radial" />

            <ImageView
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:layout_gravity="center"
                android:contentDescription="@null"
                android:src="@drawable/ic_crescent_gold" />
        </FrameLayout>
    </FrameLayout>

    <!-- ════════════════════════════════════════════════════════════════
         CONTENT — remaining 65%: scrollable prayer details on top,
         "I Prayed" / "Dismiss" pinned to the very bottom at all times.
         ════════════════════════════════════════════════════════════════ -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="65"
        android:orientation="vertical">

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:fillViewport="true">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_horizontal"
                android:orientation="vertical"
                android:paddingHorizontal="28dp"
                android:paddingTop="26dp"
                android:paddingBottom="8dp">

                <!-- Prayer name -->
                <TextView
                    android:id="@+id/textPrayerName"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="serif"
                    android:textColor="@color/gold"
                    android:textSize="34sp"
                    android:textStyle="bold" />

                <!-- Arabic prayer name -->
                <TextView
                    android:id="@+id/textArabicName"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:textColor="@color/cream"
                    android:textSize="19sp" />

                <!-- Prayer time -->
                <TextView
                    android:id="@+id/textPrayerTime"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:fontFamily="sans-serif-medium"
                    android:letterSpacing="0.04"
                    android:textColor="@color/gold"
                    android:textSize="22sp" />

                <!-- Islamic message -->
                <TextView
                    android:id="@+id/textMessage"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="22dp"
                    android:fontFamily="sans-serif"
                    android:gravity="center"
                    android:lineSpacingExtra="4dp"
                    android:textColor="@color/cream_muted"
                    android:textSize="14.5sp"
                    android:textStyle="italic" />

                <!-- Gold divider -->
                <View
                    android:layout_width="90dp"
                    android:layout_height="1dp"
                    android:layout_marginTop="24dp"
                    android:background="@color/gold_20" />

            </LinearLayout>
        </ScrollView>

        <!-- Buttons — always pinned at the bottom, never need scrolling -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="28dp"
            android:paddingTop="14dp"
            android:paddingBottom="28dp">

            <TextView
                android:id="@+id/btnIPrayed"
                android:layout_width="match_parent"
                android:layout_height="58dp"
                android:background="@drawable/bg_button_gold"
                android:fontFamily="sans-serif-medium"
                android:gravity="center"
                android:letterSpacing="0.05"
                android:text="I PRAYED  ✓"
                android:textColor="@color/navy"
                android:textSize="16sp" />

            <TextView
                android:id="@+id/btnDismiss"
                android:layout_width="match_parent"
                android:layout_height="58dp"
                android:layout_marginTop="12dp"
                android:background="@drawable/bg_button_outline"
                android:fontFamily="sans-serif"
                android:gravity="center"
                android:letterSpacing="0.05"
                android:text="DISMISS"
                android:textColor="@color/gold"
                android:textSize="16sp" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
