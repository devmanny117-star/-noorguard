<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/rootContent"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/navy">

    <!-- Full-bleed hero photo, swapped per prayer in code -->
    <ImageView
        android:id="@+id/imageHero"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:contentDescription="@null"
        android:scaleType="centerCrop" />

    <!-- Dark gradient overlay so text stays readable over the photo -->
    <View
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/bg_hero_gradient" />

    <!-- Subtle gold frame around the whole screen, matching the app's card style -->
    <View
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_margin="8dp"
        android:background="@drawable/bg_border_gold" />

    <!-- Ambient drifting gold particles, behind the text/buttons so they never interfere with reading or taps -->
    <com.noorguard.app.ParticleView
        android:id="@+id/particleView"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:fitsSystemWindows="true"
        android:paddingTop="10dp">

        <!-- Current date — always visible, never scrolls away -->
        <TextView
            android:id="@+id/textDate"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="sans-serif-medium"
            android:gravity="center"
            android:letterSpacing="0.12"
            android:paddingStart="28dp"
            android:paddingEnd="160dp"
            android:textColor="@color/gold"
            android:textSize="12sp" />

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:fillViewport="true"
            android:overScrollMode="never">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingHorizontal="28dp"
                android:paddingTop="20dp"
                android:paddingBottom="16dp">

                <!-- Gold crescent moon with a soft pulsing glow, centered -->
                <FrameLayout
                    android:id="@+id/crescentWrapper"
                    android:layout_width="64dp"
                    android:layout_height="64dp"
                    android:layout_gravity="center_horizontal">

                    <View
                        android:id="@+id/crescentGlow"
                        android:layout_width="64dp"
                        android:layout_height="64dp"
                        android:layout_gravity="center"
                        android:background="@drawable/glow_gold_radial" />

                    <ImageView
                        android:layout_width="32dp"
                        android:layout_height="32dp"
                        android:layout_gravity="center"
                        android:contentDescription="@null"
                        android:src="@drawable/ic_crescent_gold" />
                </FrameLayout>

                <!-- Prayer name with a soft gold shimmer behind it -->
                <FrameLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_horizontal"
                    android:layout_marginTop="18dp">

                    <View
                        android:id="@+id/nameGlow"
                        android:layout_width="280dp"
                        android:layout_height="120dp"
                        android:layout_gravity="center"
                        android:background="@drawable/glow_gold_radial_large" />

                    <TextView
                        android:id="@+id/textPrayerName"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center"
                        android:fontFamily="@font/playfair_display"
                        android:gravity="center"
                        android:textColor="@color/gold"
                        android:textSize="46sp"
                        android:textStyle="bold" />
                </FrameLayout>

                <TextView
                    android:id="@+id/textPrayerArabic"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:fontFamily="@font/scheherazade_new"
                    android:gravity="center"
                    android:textColor="@color/cream"
                    android:textSize="24sp" />

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_horizontal"
                    android:layout_marginTop="14dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <ImageView
                        android:layout_width="16dp"
                        android:layout_height="16dp"
                        android:contentDescription="@null"
                        android:src="@drawable/ic_clock_gold" />

                    <TextView
                        android:id="@+id/textPrayerTime"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:fontFamily="sans-serif-medium"
                        android:textColor="@color/gold"
                        android:textSize="18sp" />
                </LinearLayout>

                <View
                    android:layout_width="64dp"
                    android:layout_height="1dp"
                    android:layout_gravity="center_horizontal"
                    android:layout_marginTop="28dp"
                    android:background="@drawable/bg_divider_gold" />

                <TextView
                    android:id="@+id/textMessage"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="20dp"
                    android:fontFamily="sans-serif-light"
                    android:gravity="center"
                    android:lineSpacingExtra="4dp"
                    android:textColor="@color/cream"
                    android:textSize="14sp"
                    android:textStyle="italic" />

            </LinearLayout>
        </ScrollView>

        <!-- All 5 prayers, pinned above the buttons — populated programmatically,
             current one highlighted gold with a dot indicator underneath. -->
        <LinearLayout
            android:id="@+id/prayerPillsRow"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="20dp"
            android:layout_marginTop="12dp"
            android:orientation="horizontal" />

        <!-- Buttons — always pinned at the bottom, never need scrolling -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="28dp"
            android:paddingTop="14dp"
            android:paddingBottom="28dp">

            <TextView
                android:id="@+id/btnIPrayed"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:background="@drawable/bg_button_gold"
                android:fontFamily="sans-serif-medium"
                android:gravity="center"
                android:letterSpacing="0.05"
                android:text="I PRAYED  ✓"
                android:textColor="@color/navy"
                android:textSize="16sp" />

            <TextView
                android:id="@+id/btnDismiss"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginTop="10dp"
                android:background="@drawable/bg_button_outline"
                android:fontFamily="sans-serif"
                android:gravity="center"
                android:letterSpacing="0.05"
                android:text="DISMISS"
                android:textColor="@color/gold"
                android:textSize="16sp" />
        </LinearLayout>
    </LinearLayout>

    <!-- Small "Adhan Playing" indicator with an animated sound-wave equalizer -->
    <LinearLayout
        android:id="@+id/adhanBadge"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|end"
        android:layout_marginTop="44dp"
        android:layout_marginEnd="20dp"
        android:background="@drawable/bg_badge_navy"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="12dp"
        android:paddingVertical="8dp">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="14dp"
            android:gravity="bottom"
            android:orientation="horizontal">

            <View
                android:id="@+id/soundBar1"
                android:layout_width="3dp"
                android:layout_height="14dp"
                android:layout_marginEnd="2dp"
                android:background="@drawable/bg_sound_bar" />

            <View
                android:id="@+id/soundBar2"
                android:layout_width="3dp"
                android:layout_height="14dp"
                android:layout_marginEnd="2dp"
                android:background="@drawable/bg_sound_bar" />

            <View
                android:id="@+id/soundBar3"
                android:layout_width="3dp"
                android:layout_height="14dp"
                android:layout_marginEnd="2dp"
                android:background="@drawable/bg_sound_bar" />

            <View
                android:id="@+id/soundBar4"
                android:layout_width="3dp"
                android:layout_height="14dp"
                android:background="@drawable/bg_sound_bar" />
        </LinearLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:fontFamily="sans-serif-medium"
            android:letterSpacing="0.04"
            android:text="ADHAN PLAYING"
            android:textColor="@color/gold"
            android:textSize="10sp" />
    </LinearLayout>

    <!-- "I Prayed" celebration burst, drawn above everything else -->
    <com.noorguard.app.ConfettiView
        android:id="@+id/confettiView"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />
</FrameLayout>
