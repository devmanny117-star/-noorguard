<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/rootContent"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/navy">

    <!-- Subtle gold frame around the whole screen, matching the alarm screen's style -->
    <View
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_margin="8dp"
        android:background="@drawable/bg_border_gold" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:fitsSystemWindows="true">

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:fillViewport="true"
            android:overScrollMode="never">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:orientation="vertical"
                android:paddingHorizontal="32dp"
                android:paddingTop="48dp"
                android:paddingBottom="16dp">

                <!-- Gold crescent + star, with a soft pulsing glow behind it -->
                <FrameLayout
                    android:layout_width="72dp"
                    android:layout_height="72dp"
                    android:layout_gravity="center_horizontal">

                    <View
                        android:id="@+id/crescentGlow"
                        android:layout_width="72dp"
                        android:layout_height="72dp"
                        android:layout_gravity="center"
                        android:background="@drawable/glow_gold_radial" />

                    <ImageView
                        android:layout_width="48dp"
                        android:layout_height="48dp"
                        android:layout_gravity="center"
                        android:contentDescription="@null"
                        android:src="@drawable/ic_crescent_star_widget" />
                </FrameLayout>

                <TextView
                    android:id="@+id/textHeadline"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="22dp"
                    android:fontFamily="@font/playfair_display"
                    android:gravity="center"
                    android:textColor="@color/gold"
                    android:textSize="30sp"
                    android:textStyle="bold" />

                <View
                    android:layout_width="64dp"
                    android:layout_height="1dp"
                    android:layout_gravity="center_horizontal"
                    android:layout_marginTop="22dp"
                    android:background="@drawable/bg_divider_gold" />

                <TextView
                    android:id="@+id/textVerseArabic"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="22dp"
                    android:fontFamily="@font/scheherazade_new"
                    android:gravity="center"
                    android:lineSpacingExtra="6dp"
                    android:textColor="@color/cream"
                    android:textSize="26sp" />

                <TextView
                    android:id="@+id/textVerseTranslation"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:fontFamily="sans-serif-light"
                    android:gravity="center"
                    android:lineSpacingExtra="4dp"
                    android:textColor="@color/cream_muted"
                    android:textSize="15sp"
                    android:textStyle="italic" />

                <TextView
                    android:id="@+id/textVerseReference"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:fontFamily="sans-serif-medium"
                    android:gravity="center"
                    android:letterSpacing="0.08"
                    android:textColor="@color/gold_muted"
                    android:textSize="11sp" />
            </LinearLayout>
        </ScrollView>

        <!-- Buttons — always pinned at the bottom, never need scrolling -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="28dp"
            android:paddingTop="14dp"
            android:paddingBottom="20dp">

            <TextView
                android:id="@+id/btnIPrayed"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:background="@drawable/bg_button_gold"
                android:fontFamily="sans-serif-medium"
                android:gravity="center"
                android:letterSpacing="0.05"
                android:textColor="@color/navy"
                android:textSize="16sp" />

            <TextView
                android:id="@+id/btnReadAyahs"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginTop="10dp"
                android:background="@drawable/bg_button_outline"
                android:fontFamily="sans-serif"
                android:gravity="center"
                android:letterSpacing="0.05"
                android:textColor="@color/gold"
                android:textSize="16sp" />

            <TextView
                android:id="@+id/btnEmergencyBypass"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:fontFamily="sans-serif"
                android:gravity="center"
                android:padding="6dp"
                android:textColor="@color/white_70"
                android:textSize="12sp" />
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
